# Copy to /etc/farhelm/hub.env with mode 0600. Never commit real values.
FARHELM_HUB_BIND=127.0.0.1:8787
FARHELM_ADMIN_USER=admin
FARHELM_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
FARHELM_AGENT_TOKEN=replace-with-at-least-32-random-characters
FARHELM_CONSOLE_DIR=/opt/farhelm-hub/current/console
RUST_LOG=farhelm_hub=info

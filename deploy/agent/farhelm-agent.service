[Unit]
Description=FarHelm training host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__FARHELM_CONFIG_FILE__
WorkingDirectory=__FARHELM_INSTALL_ROOT__/current
ExecStart=__FARHELM_INSTALL_ROOT__/current/run.sh
Restart=always
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=default.target

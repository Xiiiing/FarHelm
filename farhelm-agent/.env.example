# The user installer writes these values to its private XDG data directory with mode 0600.
FARHELM_HUB_URL=https://farhelm.example.com
FARHELM_AGENT_TOKEN=use-the-token-generated-by-the-hub-installer
FARHELM_AGENT_ID=gpu-a
FARHELM_AGENT_HOSTNAME=trainer-a
FARHELM_HEARTBEAT_INTERVAL=15
FARHELM_COMMAND_POLL_INTERVAL=2
FARHELM_AGENT_DATABASE=/home/example/.local/share/farhelm-agent/state/agent.db
RUST_LOG=farhelm_agent=info
